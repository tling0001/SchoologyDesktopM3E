{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schoology",
  "version": "2026.10.0-port.5",
  "identifier": "com.schoologytauri.app",
  "build": {
    "beforeDevCommand": "npm run prepare:tauri",
    "beforeBuildCommand": "npm run prepare:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Schoology",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#f0f1f5",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 16
        },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https: http://asset.localhost data: blob:; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' ipc: http://ipc.localhost https: http: blob:; frame-src https: http: blob:; media-src 'self' https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "rpm"
    ],
    "icon": [
      "../assets/ic_launcher.png",
      "../assets/ic_launcher_256.ico",
      "../assets/ic_launcher.icns"
    ],
    "category": "Education",
    "shortDescription": "Schoology desktop application",
    "resources": {
      "../chrome-link-handler/": "chrome-link-handler/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerIcon": "../assets/ic_launcher_256.ico",
        "uninstallerIcon": "../assets/ic_launcher_256.ico",
        "startMenuFolder": "Schoology",
        "installerHooks": "nsis-hooks.nsi"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "schoology"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "schoology"
          ],
          "appLink": false
        }
      ]
    }
  }
}
