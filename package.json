{
  "name": "schoology-desktop-port",
  "version": "2026.10.0-port.2",
  "description": "Schoology desktop port aligned with the supplied Schoology Android 2026.10.0 source",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis dir --publish never",
    "dist:win": "electron-builder --win nsis dir --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux deb rpm --publish never",
    "build:updater": "node updater/prepare.js && electron-builder --config updater/electron-builder.yml --publish never",
    "postinstall": "node scripts/prepare-extension.js",
    "prepare:tauri": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "npm run prepare:tauri && tauri dev",
    "tauri:build": "npm run prepare:tauri && tauri build",
    "tauri": "tauri",
    "build:tauri-updater": "cargo build --release --manifest-path updater-tauri/Cargo.toml && node scripts/stage-updater.mjs"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3",
    "@tauri-apps/cli": "^2.12.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "@m3e/web": "2.10.1",
    "@m3e/icons": "file:vendor/m3e/icons-1.0.18.tgz",
    "@floating-ui/dom": "file:vendor/m3e/dom-1.8.0.tgz",
    "@floating-ui/core": "file:vendor/m3e/core-1.8.0.tgz",
    "@floating-ui/utils": "file:vendor/m3e/utils-0.2.12.tgz",
    "@material/material-color-utilities": "file:vendor/m3e/material-color-utilities-0.4.0.tgz",
    "composed-offset-position": "file:vendor/m3e/composed-offset-position-0.0.6.tgz",
    "lit": "^3.3.0",
    "tslib": "^2.8.1",
    "@tauri-apps/api": "^2.12.4",
    "pdfjs-dist": "^4.10.38"
  },
  "author": {
    "name": "Schoology Desktop Port",
    "email": "schoology-desktop-port@users.noreply.github.com"
  },
  "build": {
    "appId": "com.schoology.app",
    "productName": "Schoology",
    "artifactName": "Schoology-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "node_modules/@m3e/**/*",
      "node_modules/@m3e/icons/**/*",
      "node_modules/@floating-ui/**/*",
      "node_modules/@material/material-color-utilities/**/*",
      "node_modules/composed-offset-position/**/*",
      "node_modules/lit/**/*",
      "node_modules/tslib/**/*",
      "node_modules/jsqr/**/*",
      "node_modules/pdfjs-dist/**/*",
      "package.json",
      "chrome-link-handler/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/ic_launcher_256.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Schoology-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "assets/ic_launcher.icns",
      "extraResources": [
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    },
    "protocols": [
      {
        "name": "Schoology links",
        "schemes": [
          "schoology"
        ]
      }
    ],
    "linux": {
      "extraResources": [
        {
          "from": "chrome-link-handler",
          "to": "chrome-link-handler"
        }
      ]
    },
    "extraResources": [
      {
        "from": "updater/dist/SchoologyUpdater.exe",
        "to": "SchoologyUpdater.exe"
      }
    ]
  },
  "productName": "Schoology"
}
